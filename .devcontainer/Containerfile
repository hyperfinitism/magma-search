FROM rust:1.100.0-trixie@sha256:223cc32ddca8f3ee90c436dbc94b6b5f052ea7f9653c5201e9612f08ad7d21b8

RUN rustup component add rustfmt clippy

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libopenmpi-dev \
        openmpi-bin \
        procps \
        unzip \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ARG MALLOB_BUILD_JOBS=2
COPY mallob/build-mallob.sh /tmp/build-mallob.sh
RUN MALLOB_BUILD_JOBS="$MALLOB_BUILD_JOBS" bash /tmp/build-mallob.sh \
    && rm /tmp/build-mallob.sh \
    && rm -rf /mallob \
    && mv /runtime/mallob /mallob \
    && rmdir /runtime

ENV MAGMA_MALLOB_MODE=native
WORKDIR /workspaces/magma-search
